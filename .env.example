# ── Sistema ──────────────────────────────────────────────
# Usuario y grupo dueños de los archivos (ejecuta `id` en el servidor)
PUID=1000
PGID=1000
TZ=America/Mexico_City

# Carpeta del servidor donde viven los archivos. Dentro se crean videos/ y music/
MEDIA_ROOT=/srv/media

# ── Panel ────────────────────────────────────────────────
# Contraseña para entrar al panel (http://IP-DEL-SERVIDOR:8080)
PANEL_PASSWORD=cambia-esta-contraseña
# Clave para firmar la sesión. Genera una con: openssl rand -hex 32
SECRET_KEY=cambia-esto
# Tamaño máximo por archivo subido, en MB
MAX_UPLOAD_MB=8192

# ── Integraciones (se llenan después del primer arranque, ver README) ──
# Jellyfin > Panel de control > Claves de API > +
JELLYFIN_API_KEY=
# Usuario administrador que creas al entrar por primera vez a Navidrome
NAVIDROME_USER=admin
NAVIDROME_PASSWORD=
